{
  "name": "jasspass-playwright",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/JassTickets/jasspass-playwright.git",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "typescript": "5.8.3"
  },
  "scripts": {
    "cleanup:test-resources": "node scripts/cleanup-integration-test-run.cjs",
    "test:kickback": "playwright test --project=kickback --workers=1",
    "test:kickback:integration": "playwright test --project=kickback --workers=1",
    "test:kickback:typecheck": "tsc -p tsconfig.kickback.json",
    "test:testlab": "playwright test",
    "test:critical": "playwright test jasspass-tests/tests/critical_paths --project=chromium",
    "test:critical:cross-browser": "playwright test jasspass-tests/tests/critical_paths",
    "test:country-currency-matrix": "playwright test --project=country-currency-matrix",
    "test:seating-integration": "playwright test --project=seating-integration",
    "test:list": "playwright test --list"
  }
}
